# Copy this file to .env.local and fill in the values. NEVER commit .env.local.

# Supabase → Project Settings → API (safe to expose to the browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase → Project Settings → API → service_role key.
# SERVER ONLY. Grants full database access. Used for officer invitations, backups/restores
# and the bootstrap script. Never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public URL of the app (used in invitation and password-reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for the automated database tests (npm run test:db). Local Supabase default shown.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
